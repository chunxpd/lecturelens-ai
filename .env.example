# Server configuration only. Never set Gemini/OpenAI API keys on the host.
# Each user enters their own keys in the browser.
PORT=3100
APP_URL=http://localhost:3100
OPENAI_SLIDE_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1-mini

# For HTTPS termination behind a known trusted reverse proxy, set the exact
# proxy hop count, e.g. 1 ONLY when there is one trusted proxy and direct access is blocked.
TRUST_PROXY_HOPS=0
ENABLE_LOCAL_SOURCE_EXPORT=false
